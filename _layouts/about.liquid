---
layout: default
---
{% comment %}
  One-page home. Every section lives on this page, in this order, and each one
  links out to its full page for the long version.
{% endcomment %}

{% if site.navbar_fixed %}
  {% assign nav_offset = '60px' %}
{% else %}
  {% assign nav_offset = '0px' %}
{% endif %}

<style>
  .home-nav {
    position: sticky;
    top: {{ nav_offset }};
    z-index: 10;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.4rem;
    overflow-x: auto;
    margin: 2rem 0 0;
    padding: 0.6rem 0;
    background-color: var(--global-bg-color);
    border-bottom: 1px solid var(--global-divider-color);
    scrollbar-width: none;
  }

  .home-nav::-webkit-scrollbar {
    display: none;
  }

  .home-nav a {
    flex: 0 0 auto;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 999px;
    color: var(--global-text-color-light);
    font-size: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .home-nav a:hover,
  .home-nav a.is-current {
    color: var(--global-hover-text-color);
    background-color: var(--global-hover-color);
    border-color: var(--global-hover-color);
  }

  .home-section {
    padding-top: 2.5rem;
    /* so an anchor jump does not hide the heading under the sticky bar */
    scroll-margin-top: calc({{ nav_offset }} + 3.5rem);
  }

  .home-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .home-section-head h2 {
    margin: 0 0 0.3rem;
  }

  .home-section-head .home-section-all {
    flex: 0 0 auto;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .home-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .home-timeline > li {
    padding: 0 0 1.2rem 1rem;
    border-left: 2px solid var(--global-divider-color);
  }

  .home-timeline > li:last-child {
    padding-bottom: 0;
  }

  .home-timeline .role {
    font-weight: 600;
  }

  .home-timeline .org {
    color: var(--global-text-color-light);
    font-size: 0.9rem;
  }

  .home-timeline ul {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.9rem;
  }

  .home-service {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
  }

  .home-service li + li {
    margin-top: 0.3rem;
  }

  @media (max-width: 576px) {
    .home-section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }
  }
</style>

<div class="post">
  <header class="post-header" id="about">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- Section nav -->
    <nav class="home-nav" aria-label="Sections of this page">
      <a href="#about">about</a>
      {% if page.home_sections.research %}
        <a href="#research">research</a>
      {% endif %}
      {% if page.home_sections.publications %}
        <a href="#publications">publications</a>
      {% endif %}
      {% if page.home_sections.experience %}
        <a href="#experience">experience</a>
      {% endif %}
      {% if page.announcements and page.announcements.enabled %}
        <a href="#news">news</a>
      {% endif %}
      {% if page.latest_posts and page.latest_posts.enabled %}
        <a href="#writing">writing</a>
      {% endif %}
      {% if page.social %}
        <a href="#contact">contact</a>
      {% endif %}
    </nav>

    <!-- Research -->
    {% if page.home_sections.research %}
      <section class="home-section" id="research">
        <div class="home-section-head">
          <h2>research</h2>
          <a class="home-section-all" href="{{ '/projects/' | relative_url }}">all projects &rarr;</a>
        </div>
        <div class="projects">
          <div class="container">
            <div class="row row-cols-1 row-cols-md-2">
              {% assign home_projects = site.projects | sort: 'importance' %}
              {% for project in home_projects %}
                {% include projects_horizontal.liquid %}
              {% endfor %}
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    <!-- Publications -->
    {% if page.home_sections.publications %}
      <section class="home-section" id="publications">
        <div class="home-section-head">
          <h2>publications</h2>
          <a class="home-section-all" href="{{ '/publications/' | relative_url }}">all publications &rarr;</a>
        </div>
        <div class="publications">{% bibliography %}</div>
      </section>
    {% elsif page.selected_papers %}
      <section class="home-section" id="publications">
        <div class="home-section-head">
          <h2>selected publications</h2>
          <a class="home-section-all" href="{{ '/publications/' | relative_url }}">all publications &rarr;</a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Experience, education and service, from the same file as the CV page -->
    {% if page.home_sections.experience and site.data.resume %}
      <section class="home-section" id="experience">
        <div class="home-section-head">
          <h2>experience</h2>
          <a class="home-section-all" href="{{ '/cv/' | relative_url }}">full cv &rarr;</a>
        </div>

        {% if site.data.resume.work %}
          {% comment %}
            No entry carries a startDate yet, and the CV page sorts on it, which
            leaves the CV showing the file in reverse. Reverse here too so both
            pages list the same group first.
          {% endcomment %}
          {% assign home_work = site.data.resume.work | reverse %}
          <ul class="home-timeline">
            {% for job in home_work %}
              <li>
                <div class="role">{{ job.position }}</div>
                <div class="org">{{ job.name }}</div>
                {% if job.highlights %}
                  <ul>
                    {% for item in job.highlights %}
                      <li>{{ item }}</li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if site.data.resume.education %}
          <h3 class="mt-4" style="font-size: 1.1rem">education</h3>
          <ul class="home-timeline">
            {% for school in site.data.resume.education %}
              <li>
                <div class="role">{{ school.studyType }}, {{ school.area }}</div>
                <div class="org">
                  {{ school.institution -}}
                  {%- if school.location %}, {{ school.location }}{% endif %}
                </div>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if site.data.resume.volunteer %}
          <h3 class="mt-4" style="font-size: 1.1rem">academic service</h3>
          <ul class="home-service">
            {% for entry in site.data.resume.volunteer %}
              <li>{{ entry.position }}, {{ entry.organization }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section" id="news">
        <div class="home-section-head">
          <h2>news</h2>
          <a class="home-section-all" href="{{ '/news/' | relative_url }}">all news &rarr;</a>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Writing -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-section" id="writing">
        <div class="home-section-head">
          <h2>writing</h2>
          <a class="home-section-all" href="{{ '/blog/' | relative_url }}">all posts &rarr;</a>
        </div>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <!-- Contact -->
    {% if page.social %}
      <section class="home-section" id="contact">
        <div class="home-section-head">
          <h2>contact</h2>
        </div>
        <div class="social">
          <div class="contact-icons">{% include social.liquid %}</div>

          <div class="contact-note">{{ site.contact_note }}</div>
        </div>
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>

<script>
  // Mark the section the reader is currently in.
  (function () {
    const links = Array.from(document.querySelectorAll('.home-nav a'));
    if (!links.length) return;
    const sections = links.map((link) => document.querySelector(link.getAttribute('href'))).filter(Boolean);
    if (!sections.length) return;

    const setCurrent = (id) => {
      links.forEach((link) => link.classList.toggle('is-current', link.getAttribute('href') === '#' + id));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length) setCurrent(visible[0].target.id);
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
    );

    sections.forEach((section) => observer.observe(section));
  })();
</script>
