<style>
  /* "Can a virtual cell predict a pathway it has never seen switch on?" -- post-scoped styles.
   Neutrals come from al-folio's theme variables, so the light/dark toggle applies. */
  :root {
    --sp-fg: var(--global-text-color);
    --sp-muted: var(--global-text-color-light);
    --sp-rule: var(--global-divider-color);
    --sp-bg: var(--global-bg-color);
    --sp-surface: var(--global-card-bg-color);
    --sp-blue: #2a78d6;
    --sp-orange: #eb6834;
    --sp-aqua: #1baf7a;
    --sp-magenta: #e87ba4;
    --sp-violet: #6250d6;
    --sp-green: #008300;
    --sp-grey: #8f9694;
    --sp-membrane: #e4e9e7;
    --sp-nucleus: #eef3f1;
    --sp-gene: #c8d1ce;
    --sp-ctrl-fill: #e1ecfa;
    --sp-stim-fill: #fce4d9;
    --sp-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  html[data-theme='dark'] {
    --sp-blue: #3987e5;
    --sp-orange: #d95926;
    --sp-aqua: #199e70;
    --sp-magenta: #d55181;
    --sp-violet: #9085e9;
    --sp-green: #2f9a2f;
    --sp-grey: #7d8684;
    --sp-membrane: #27312f;
    --sp-nucleus: #172221;
    --sp-gene: #3c4846;
    --sp-ctrl-fill: #1b2a3d;
    --sp-stim-fill: #3a2318;
  }
  /* Figure 1 breaks out of the 930px column so its three panels stay legible */
  figure.sp-hero {
    width: min(1120px, calc(100vw - 48px));
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    margin: 1.5rem 0 0.75rem;
  }
  .sp-panel-title {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0 0 6px;
    color: var(--sp-fg);
  }
  .sp-panel-title b {
    color: var(--sp-muted);
    margin-right: 4px;
  }
  .sp-caption {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--sp-muted);
    margin-bottom: 2rem;
  }
  .sp-caption strong {
    color: var(--sp-fg);
  }
  .sp-fig {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 20px 28px;
    margin: 1.5rem 0 0.75rem;
  }
  .sp-panel {
    min-width: 0;
  }
  .sp-wide {
    grid-column: 1 / -1;
  }
  .sp-chart {
    width: 100%;
    min-height: 120px;
  }
  .sp-chart svg {
    display: block;
    overflow: visible;
    max-width: 100%;
  }
  .sp-chart text {
    font-family: inherit;
    fill: var(--sp-muted);
  }
  .sp-chart .tick {
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .sp-chart .lab {
    font-size: 12px;
    fill: var(--sp-fg);
  }
  .sp-chart .val {
    font-size: 11px;
    font-family: var(--sp-mono);
  }
  .sp-chart .axis {
    font-size: 12px;
  }
  .sp-chart .dlab {
    font-size: 11.5px;
    fill: var(--sp-fg);
  }
  .sp-chart .grid {
    stroke: var(--sp-rule);
    stroke-width: 1;
  }
  .sp-chart .zero {
    stroke: var(--sp-muted);
    stroke-width: 1;
  }
  .sp-chart .ref {
    stroke: var(--sp-muted);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .sp-chart .cross {
    stroke: var(--sp-muted);
    stroke-width: 1;
  }
  .sp-chart .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-size: 12.5px;
    color: var(--sp-muted);
    margin-top: 6px;
  }
  .sp-chart .legend > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .sp-chart .sw,
  #sp-tip .sw {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    margin-right: 6px;
    vertical-align: -1px;
  }
  .sp-chart .legend .sw {
    margin-right: 0;
  }
  .sp-chart .sw.dash,
  #sp-tip .sw.dash {
    height: 0;
    border-top: 2px dashed;
    border-radius: 0;
    width: 14px;
  }
  #sp-tip {
    position: fixed;
    z-index: 1100;
    pointer-events: none;
    background: var(--global-bg-color);
    color: var(--global-text-color);
    border: 1px solid var(--global-divider-color);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.12);
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 12.5px;
    line-height: 1.5;
    max-width: 300px;
  }
  #sp-tip[hidden] {
    display: none;
  }
  #sp-tip .muted {
    color: var(--global-text-color-light);
  }
  .sp-table-wrap {
    overflow-x: auto;
    margin-bottom: 0.75rem;
  }
  .sp-table-wrap table {
    display: block;
    overflow-x: auto;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    border-collapse: collapse;
  }
  .sp-table-wrap th,
  .sp-table-wrap td {
    padding: 5px 10px;
    white-space: nowrap;
    text-align: right;
    border-bottom: 1px solid var(--sp-rule);
    font-variant-numeric: tabular-nums;
  }
  .sp-table-wrap th:first-child,
  .sp-table-wrap td:first-child {
    text-align: left;
  }
  .sp-audit table th,
  .sp-audit td {
    white-space: normal;
    text-align: left;
    vertical-align: top;
    line-height: 1.45;
  }
  .sp-audit td:first-child {
    font-weight: 500;
    width: 30%;
  }
  .sp-audit td:nth-child(2) {
    width: 32%;
    color: var(--sp-muted);
  }
  @media (max-width: 640px) {
    .sp-audit thead {
      display: none;
    }
    .sp-audit table,
    .sp-audit tbody,
    .sp-audit tr,
    .sp-audit td {
      display: block;
      width: auto !important;
    }
    .sp-audit tr {
      padding: 8px 0;
      border-bottom: 1px solid var(--sp-rule);
    }
    .sp-audit td {
      border: 0;
      padding: 2px 0;
    }
    .sp-audit td::before {
      display: block;
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--sp-muted);
      font-weight: 600;
      margin-top: 4px;
    }
    .sp-audit td:nth-child(1)::before {
      content: 'Objection';
    }
    .sp-audit td:nth-child(2)::before {
      content: 'What we did';
    }
    .sp-audit td:nth-child(3)::before {
      content: 'What happened';
    }
  }
  /* Figure 1 schematic */

  .schem-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px 28px;
  }
  .schem {
    width: 100%;
    height: auto;
    display: block;
    max-width: 460px;
    margin: 0 auto;
  }
  .schem text {
    font-family: inherit;
    font-size: 12px;
    fill: var(--sp-fg);
  }
  .schem .sm {
    font-size: 11px;
  }
  .schem .muted {
    fill: var(--sp-muted);
  }
  .schem .b {
    font-weight: 600;
  }
  .schem .mono {
    font-family: var(--sp-mono);
    font-size: 11px;
  }
  .schem .lig {
    fill: none;
    stroke: var(--sp-orange);
    stroke-width: 1.8;
    stroke-dasharray: 3 2.5;
  }
  .schem .membrane {
    fill: var(--sp-membrane);
  }
  .schem .memline {
    stroke: var(--sp-muted);
    stroke-width: 1;
  }
  .schem .prot {
    fill: var(--sp-surface);
    stroke: var(--sp-fg);
    stroke-width: 1.2;
  }
  .schem .cf {
    stroke: var(--sp-orange);
    stroke-width: 1.9;
    stroke-dasharray: 5 3.5;
    fill: none;
  }
  .schem .bracket {
    fill: none;
    stroke: var(--sp-muted);
    stroke-width: 1.1;
  }
  .schem .nucleus {
    fill: var(--sp-nucleus);
    stroke: var(--sp-fg);
    stroke-width: 1.2;
  }
  .schem .dna {
    stroke: var(--sp-fg);
    stroke-width: 1.3;
  }
  .schem .isre {
    fill: var(--sp-surface);
    stroke: var(--sp-aqua);
    stroke-width: 2;
  }
  .schem .gene {
    fill: var(--sp-gene);
    stroke: var(--sp-fg);
    stroke-width: 1;
  }
  .schem .mrna {
    fill: none;
    stroke: var(--sp-muted);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .schem .m-int {
    fill: var(--sp-orange);
  }
  .schem .m-mech {
    fill: var(--sp-aqua);
  }
  .schem .m-fg {
    fill: var(--sp-fg);
  }
  .schem .m-mut {
    fill: var(--sp-muted);
  }
  .schem .frame {
    fill: var(--sp-surface);
    stroke: var(--sp-rule);
  }
  .schem .obsdot {
    fill: var(--sp-blue);
    fill-opacity: 0.42;
  }
  .schem .obsdot.solid {
    fill-opacity: 1;
  }
  .schem .cand {
    stroke: var(--sp-muted);
    stroke-width: 1.1;
    stroke-dasharray: 2 3;
  }
  .schem .mecharrow {
    stroke: var(--sp-aqua);
    stroke-width: 2.8;
  }
  .schem .target {
    fill: none;
    stroke: var(--sp-orange);
    stroke-width: 1.4;
    stroke-dasharray: 4 3;
  }
  .schem .intdot {
    fill: var(--sp-orange);
    stroke: var(--sp-surface);
    stroke-width: 1.2;
  }
  .schem .ruler {
    stroke: var(--sp-fg);
    stroke-width: 1;
  }
  .schem .ctrlcell {
    fill: var(--sp-ctrl-fill);
    stroke: var(--sp-blue);
    stroke-width: 1;
  }
  .schem .stimcell {
    fill: var(--sp-stim-fill);
    stroke: var(--sp-orange);
    stroke-width: 1;
  }
  .schem .hidden {
    fill: none;
    stroke: var(--sp-muted);
    stroke-width: 1.1;
    stroke-dasharray: 4 3;
  }
  .schem .priorpill {
    fill: var(--sp-surface);
    stroke: var(--sp-aqua);
    stroke-width: 1.8;
  }
  .schem .modelbox {
    fill: var(--sp-surface);
    stroke: var(--sp-fg);
    stroke-width: 1.6;
  }
  .schem .predbox {
    fill: var(--sp-surface);
    stroke: var(--sp-fg);
    stroke-width: 1.1;
  }
  .schem .flow {
    stroke: var(--sp-fg);
    stroke-width: 1.3;
  }
  /* long display equations scroll inside their own box on phones; long DOI links wrap */
  #markdown-content mjx-container[display='true'] {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }
  #markdown-content a {
    overflow-wrap: anywhere;
  }
</style>
