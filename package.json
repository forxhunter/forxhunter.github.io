{
  "name": "forxhunter.github.io",
  "description": "Tianyu Wu's personal site, built on the as-folio Astro template",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build --timings && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "astro check && tsc --noEmit",
    "test:all": "yarn test:types && yarn lint:ci && yarn test",
    "validate": "yarn test:all",
    "citations:update": "node --strip-types scripts/update-citations.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/mdx": "^6.0.0",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/react": "^5.0.7",
    "@astrojs/rss": "^4.0.18",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-condensed": "^5.2.8",
    "@fontsource/source-code-pro": "^5.2.7",
    "@iconify-json/academicons": "^1.2.4",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/fa-regular": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.4.8",
    "js-yaml": "^4.2.0",
    "medium-zoom": "^1.1.0",
    "ninja-keys": "^1.2.2",
    "pseudocode": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.2",
    "unplugin-icons": "^23.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.10.6",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "private": true
}
